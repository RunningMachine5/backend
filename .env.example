# 로컬 개발용 기본값입니다. 운영 환경에서는 반드시 별도 비밀번호를 사용하세요.
POSTGRES_USER=root
POSTGRES_PASSWORD=1234
POSTGRES_DB=fdshield-db

# Backend를 호스트 Python으로 실행할 때 사용하는 주소입니다.
# Docker Compose의 Backend에는 컨테이너용 db:5432 주소가 별도로 주입됩니다.
# 비밀번호에 URL 예약 문자가 있으면 URL 인코딩한 값을 사용해야 합니다.
DATABASE_URL=postgresql+psycopg://root:1234@localhost:5432/fdshield-db

# Backend를 호스트에서 실행할 때 호출할 ML Stub 주소입니다.
ML_SERVING_URL=http://localhost:8001
ML_SERVING_TIMEOUT_SECONDS=5
ML_SERVING_MAX_ATTEMPTS=2
ML_SERVING_RETRY_DELAY_SECONDS=0.25
# 로컬 Stub은 none, GCE VM에서 Private Cloud Run 호출 시 google-id-token을 사용합니다.
ML_SERVING_AUTH_MODE=none
# Backend도 Docker로 실행하면 아래 주소를 docker-compose.local.yml이 사용합니다.
ML_SERVING_DOCKER_URL=http://host.docker.internal:8001

# 관리자 전용 학습·배포 API. 빈 값이면 /mlops API는 503으로 비활성화됩니다.
# 운영 값은 Git에 넣지 말고 VM의 보호된 .env 또는 Secret Manager에서 주입하세요.
MLOPS_ADMIN_TOKEN=local-dev-mlops-token
GCP_PROJECT_ID=project-4cc3406c-72d8-4907-a5d
GCP_REGION=asia-northeast3
CLOUD_RUN_TRAINING_JOB=fdshield-binary-training
CLOUD_RUN_TRAINING_CONTAINER=
CLOUD_RUN_SERVING_SERVICE=fdshield-ml-serving
CLOUD_RUN_SERVING_CONTAINER=
CLOUD_RUN_ADMIN_TIMEOUT_SECONDS=20
MLOPS_MODEL_NAME=fdshield-fraud-detector
MLOPS_MODEL_ALIAS=champion

# 로컬 빌드 기본 이미지명입니다. 개발 VM CD에서는 Artifact Registry의 커밋 SHA 이미지로 덮어씁니다.
BACKEND_IMAGE=fdshield/backend:local
# open ai api key
OPENAI_API_KEY=test-only-key
