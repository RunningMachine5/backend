# 이 파일을 .env로 복사해 사용하는 로컬 개발용 예시입니다.
# 실제 비밀번호·토큰·API 키는 Git에 커밋하지 마세요.

# --- 로컬 PostgreSQL -------------------------------------------------------
POSTGRES_USER=root
POSTGRES_PASSWORD=1234
POSTGRES_DB=fdshield-db

# Backend를 호스트 Python으로 실행할 때 사용하는 주소입니다.
# Docker Compose의 Backend에는 컨테이너용 db:5432 주소가 별도로 주입됩니다.
# 비밀번호에 URL 예약 문자가 있으면 URL 인코딩한 값을 사용해야 합니다.
DATABASE_URL=postgresql+psycopg://root:1234@localhost:5432/fdshield-db

# --- ML Serving ------------------------------------------------------------
# Backend를 호스트에서 실행할 때 호출할 model80 ML Serving 주소입니다.
ML_SERVING_URL=http://localhost:8001
# 한 번의 호출 제한시간과 일시 오류 재시도 설정입니다.
ML_SERVING_TIMEOUT_SECONDS=5
ML_SERVING_MAX_ATTEMPTS=2
ML_SERVING_RETRY_DELAY_SECONDS=0.25
# 로컬 모델 Serving은 none, GCE VM에서 Private Cloud Run 호출 시 google-id-token을 사용합니다.
ML_SERVING_AUTH_MODE=none
# Backend도 Docker로 실행하면 아래 주소를 docker-compose.local.yml이 사용합니다.
ML_SERVING_DOCKER_URL=http://host.docker.internal:8001

# --- 관리자 API·Cloud Run 연동 --------------------------------------------
# 관리자 전용 학습·배포 API. 빈 값이면 /mlops API는 503으로 비활성화됩니다.
# 로컬 룰 관리 테스트에서는 아래 예시 토큰을 요청 헤더에도 동일하게 사용합니다.
# 운영 값은 Git에 넣지 말고 VM의 보호된 .env 또는 Secret Manager에서 주입하세요.
MLOPS_ADMIN_TOKEN=local-dev-mlops-token
# 아래 GCP 값은 거래·룰 로컬 테스트에는 사용되지 않고 실제 Cloud Run 제어 시 필요합니다.
GCP_PROJECT_ID=project-4cc3406c-72d8-4907-a5d
GCP_REGION=asia-northeast3
CLOUD_RUN_TRAINING_JOB=fdshield-binary-training
CLOUD_RUN_TRAINING_CONTAINER=
CLOUD_RUN_SERVING_SERVICE=fdshield-ml-serving
CLOUD_RUN_SERVING_CONTAINER=
CLOUD_RUN_ADMIN_TIMEOUT_SECONDS=20
MLOPS_MODEL_NAME=fdshield-fraud-detector-v2
MLOPS_MODEL_ALIAS=champion
# 모델 버전·학습 지표·비교 결과의 원본인 MLflow 연결 정보입니다.
# 로컬에서 실제 승인/승격 API를 쓰지 않으면 비워 둘 수 있습니다.
# 운영 username/password는 Secret Manager 또는 보호된 .env에서만 주입하세요.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TIMEOUT_SECONDS=10

# --- 이미지·기타 스켈레톤 -------------------------------------------------
# 로컬 빌드 기본 이미지명입니다. 개발 VM CD에서는 Artifact Registry의 커밋 SHA 이미지로 덮어씁니다.
BACKEND_IMAGE=fdshield/backend:local
# Agent·챗봇을 실제 호출하지 않는 로컬 테스트에서는 아래 더미값으로 충분합니다.
# 실제 OpenAI 기능을 테스트할 때만 각자 발급한 키를 로컬 .env에 넣고 공유하지 마세요.
OPENAI_API_KEY=test-only-key
# Agent 모델 분리 실험용 설정이다. 값이 없으면 OPENAI_MODEL을 사용한다.
OPENAI_MODEL=gpt-5-mini
AGENT_INVESTIGATION_MODEL=gpt-5-mini
AGENT_RESPONSE_PLAN_MODEL=gpt-5-mini

# --- 고객 대응 챗봇 ---------------------------------------------------------
# 고객에게 전달할 채팅 URL의 Backend 기준 주소와 이메일 주소가 없을 때의 폴백입니다.
CHAT_BASE_URL=http://localhost:8000
CHAT_FALLBACK_EMAIL=abcd@kosa.com
# 응답 평가·고객 행동·사기 정황 추출 LLM 호출에 공통으로 적용합니다.
# 가장 느린 가이드 검색 질의 분해가 최악 5초 안팎이므로 그보다 짧게 잡지 않습니다.
CHAT_LLM_TIMEOUT_SECONDS=30
CHAT_LLM_MAX_ATTEMPTS=2
# 네 호출 모두 같은 모델을 씁니다. 작은 모델이 오히려 추론 토큰을 더 써서 느렸습니다.
CHAT_LLM_MODEL=gpt-5.6-luna
# 고객에게 나가는 생성만 따로 갈아끼울 여지를 두려고 변수는 남겨둡니다.
CHAT_RESPONSE_LLM_MODEL=gpt-5.6-luna
# 추론 토큰이 지연을 지배하므로 낮춰 씁니다. minimal은 평가 LLM이 오판합니다.
CHAT_LLM_REASONING_EFFORT=low

# --- 이상거래 고객 안내 이메일 ---------------------------------------------
# Gmail은 일반 비밀번호가 아니라 Google 계정에서 발급한 앱 비밀번호를 사용한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FDShield
SMTP_TIMEOUT_SECONDS=7

# --- LangSmith 트레이싱 -----------------------------------------------------
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=FDS_CHATBOT

# --- RAG 평가(RAGAS) -------------------------------------------------------
# 채점을 맡는 심판 LLM. 재현성을 위해 temperature 를 낮춰 호출하므로 temperature 를
# 받는 모델이어야 합니다. 평가받는 챗봇 모델(CHAT_LLM_MODEL)과는 별개입니다.
RAGAS_JUDGE_MODEL=gpt-4.1-mini
# 심판 LLM 의 temperature. 채점 재현을 위해 0으로 둡니다.
# 빈 값이면 temperature 를 보내지 않습니다(지정을 거부하는 모델용, 재현 불가)
RAGAS_JUDGE_TEMPERATURE=0

# --- 금융감독원 Open API ----------------------------------------------------
FSS_AUTH_KEY=
